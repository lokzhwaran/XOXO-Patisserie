# Database (required)
# Local dev: run `docker compose up -d` (see docker-compose.yml) then use the URL below.
# Production: use your Supabase project's connection string (Settings > Database > Connection string).
DATABASE_URL="postgresql://xoxobakery:xoxobakery@localhost:5432/xoxobakery"

# App mode: "sandbox" (default, zero external accounts, everything simulated) or "live"
# (real Razorpay/WhatsApp/Resend/Porter — the vars below become required, see src/lib/env.ts).
APP_MODE="sandbox"

# Required in production: signs admin session cookies. Generate with `openssl rand -hex 32`.
# The app refuses to start in production without this set (see src/lib/env.ts).
SESSION_SECRET=""

# Sandbox admin account. Use these variable names; `@` and `.` belong in the value, not the key.
# Example Render entries: ADMIN_EMAIL = admin@bakery.local, ADMIN_PASSWORD = Admin@12345
ADMIN_EMAIL="admin@bakery.local"
ADMIN_PASSWORD="Admin@12345"

# App URL (used in WhatsApp/email links, tracking links, webhooks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Auth (admin login) — from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Supabase Storage (product images) — same project as above
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="product-images"

# Razorpay — test mode keys are free from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Set in Razorpay Dashboard > Settings > Webhooks, pointing to /api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=""

# WhatsApp Cloud API (Meta) — https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Resend (transactional email) — https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="XOXO Patisserie <orders@yourdomain.com>"

# Porter delivery API — business/enterprise accounts only, request access from Porter.
# Leave blank to use the always-available Manual delivery flow.
PORTER_API_KEY=""
PORTER_BASE_URL="https://pfe-apigw-prod.porter.in"
