{
  "name": "xoxobakery",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "postinstall": "prisma generate",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "setup": "tsx scripts/setup.ts",
    "db:up": "tsx scripts/db-up.ts",
    "db:down": "tsx scripts/db-down.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:minimal": "tsx prisma/seed.ts --minimal",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "templates:validate": "tsx scripts/validate-templates.ts",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@prisma/client": "^6.3.1",
    "@supabase/supabase-js": "^2.48.1",
    "@supabase/ssr": "^0.5.2",
    "zustand": "^5.0.3",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-table": "^8.21.2",
    "react-hook-form": "^7.54.2",
    "@hookform/resolvers": "^3.10.0",
    "zod": "^3.24.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "recharts": "^2.15.1",
    "razorpay": "^2.9.5",
    "resend": "^4.1.2",
    "framer-motion": "^12.0.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0",
    "lucide-react": "^0.474.0",
    "sonner": "^1.7.4",
    "@radix-ui/react-dialog": "^1.1.5",
    "@radix-ui/react-dropdown-menu": "^2.1.5",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-select": "^2.1.5",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-toast": "^1.2.5",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-popover": "^1.1.5",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@react-pdf/renderer": "^4.1.6",
    "nanoid": "^5.0.9",
    "qrcode": "^1.5.4",
    "embedded-postgres": "17.9.0-beta.17"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "vitest": "^3.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@playwright/test": "^1.50.1"
  }
}
